@prefix : <http://example.org/example/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix demo: <http://example.org/example/demonstrator/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ldio: <http://example.org/example/ldio/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix proc: <http://dishacled.example.org/processors#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdfc: <https://w3id.org/rdf-connect#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix sw: <https://semantic.works/services/> .
@prefix tcs: <https://w3id.org/toolchain#> .
@prefix tm: <https://w3id.org/rdf-connect/threshold-monitor#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix shape:   <http://www.example.org/shapes/> .

 demo:DishacledPipeline a tcs:PipelineDefinition ;
    rdfs:label "DiSHACLed demonstrator pipeline (scenario b)" ;
    rdfs:comment """
        Unannotated api -> 
        polling -> 
        shacl-processor with contracts of sample 
           | -[failing branch]-> "email it"
           | -[succeeding branch]-> 
                threshold-monitor -> 
                oslc:Error alerts in store '->' 
                email write '->' 
                delivery 
        """ .

# ! only defining what's new here for now
      
demo:dynamicCheckCM a tcs:InstancePipelineComponent ;
    prov:specializationOf rdfc:SHACLProcessorTS ;
    p-plan:isStepOfPlan demo:DishacledPipeline ;
    p-plan:hasInputVar [
        a tcs:WrappedPipelineConfig ;
        tcs:embedded [
            tcs:shapes shape:Observation ;
        ]
    ] ;
    tcs:channelMap [ 
        dct:name rdfc:outgoing ; 
        dct:link _:dynamicCheckCMSucceeding 
    ] , [
        dct:name rdfc:report ; 
        dct:link _:dynamicCheckCMFailing
    ] ;
    dcat:qualifiedRelation [
        a dcat:Relationship ;
        dcat:hadRole tcs:outputShape ;
        tcs:about _:dynamicCheckCMSucceeding ;
        dct:relation shape:Observation
    ] .

[ 
    a tcs:Connection ;
    tcs:from _:dynamicCheckCMSucceeding ;
    tcs:to demo:ThresholdMonitor
] .

[ 
    a tcs:Connection ;
    tcs:from _:dynamicCheckCMFailing ;
    tcs:to demo:TriggerAlertIT
] .

demo:ThresholdMonitor a tcs:InstancePipelineComponent.
    # ....

demo:TriggerAlertIT a tcs:InstancePipelineComponent.
    # ...