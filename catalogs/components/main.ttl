@prefix : <http://example.org/example/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ldio: <http://example.org/example/ldio/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix proc: <http://dishacled.example.org/processors#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfc: <https://w3id.org/rdf-connect#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix sw: <https://semantic.works/services/> .
@prefix tcs: <https://w3id.org/toolchain#> .
@prefix tm: <https://w3id.org/rdf-connect/threshold-monitor#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


# simplifying by only having the components that are going to appear in the logical pipeline definition

:DishacledCatalog
  a tcs:Catalog, dcat:Catalog;
  dct:title "Catalog of Pipeline Components" ;
  dcat:resource
    # LDIO — Inputs
    ldio:HttpInPoller,
    ldio:HttpIn,
    ldio:AmqpIn,
    ldio:KafkaIn,
    ldio:LdesClient,
    ldio:LdesClientConnector,
    # LDIO — Adapters
    ldio:RmlAdapter, 
    ldio:RdfAdapter, 
    ldio:JsonToLdAdapter,
    ldio:NgsiV2ToLdAdapter,
    # LDIO — Transformers
    ldio:SparqlConstructTransformer,
    ldio:ChangeDetectionFilter,
    ldio:GeoJsonToWktTransformer,
    ldio:HttpEnricher,
    ldio:VersionMaterialiser,
    ldio:VersionObjectCreator,
    # LDIO — Outputs
    ldio:ConsoleOut,
    ldio:HttpOut, 
    ldio:AmqpOut,
    ldio:KafkaOut,
    ldio:RepositoryMaterialiser,
    # LDIO — Orchestrator
    ldio:LinkedDataInteractionsOrchestrator,
    ldio:LdioPipelineStarterService ,
    # RDF Connect
    rdfc:HttpFetch,
    rdfc:HttpIn,
    rdfc:HttpServer,
    rdfc:Sdsify,
    rdfc:SkolemizationProcessor,
    rdfc:LogProcessorJs,
    rdfc:thresholdMonitoringProcessor,
    rdfc:SPARQLIngest,
    rdfc:LogProcessorPy,
    rdfc:HttpOut,
    rdfc:NodeRunner,
    rdfc:PyRunner,
    rdfc:Orchestrator,
    tm:ThresholdMonitorJs,
    proc:JsonLdToNQuads ,
    # Semantic.Works
    sw:loket-error-alert-service,
    sw:deliver-email-service ,
    sw:triple-store,
    sw:mu-identifier,
    sw:mu-dispatcher,
    sw:mu-cl-resources,
    sw:mu-delta-notifier,
    sw:mu-authorization .