@prefix : <http://example.org/example/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix mu: <http://mu.semte.ch/vocabularies/core/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sw: <https://semantic.works/services/> .
@prefix tcs: <https://w3id.org/toolchain#> .

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix oslc: <http://open-services.net/ns/core#> .
@prefix nmo:  <http://www.semanticdesktop.org/ontologies/2007/03/22/nmo#> .
@prefix loket: <http://lblod.data.gift/shapes/loket-error-alert-service/> .

# ! We can use a generic config service for semantic works services (enough for what we are using here), providing the following support;
# 1. delta rule
# 2. docker variable
# 3. any file (path + contents)
# such configs can be easily handled by pipeline generator

# ! Afterwards, we can specify 
# 1.`tcs:wrappedConfigShape`'s for each service; these specify only the minimal spec required from user
# 2.`tcs:unwrapConfig` for each service

sw:genericSWConfigShape a sh:NodeShape.
# ....

sw:loket-error-alert-service a tcs:PipelineComponent, mu:Microservice, dcat:Resource ;
  rdfs:description "Service that is responsible for sending out alerts when errors are inserted in the store. Build using the MU Javascript template.";
  dcat:landingPage <https://github.com/lblod/loket-error-alert-service> ;
  dct:requires sw:triple-store ,
               sw:mu-delta-notifier ,
               sw:mu-identifier ;
  dcat:qualifiedRelation [
        dcat:hadRole tcs:inputShape ;
        dct:relation loket:ErrorShape
    ] ,
    [
        dcat:hadRole tcs:outputShape ;
        dct:relation loket:EmailShape
    ] ,
        [
        a dcat:Relationship;
        dcat:hadRole tcs:configShape ;
        dct:relation sw:genericSWConfigShape 
        ],
        [
        a dcat:Relationship;
        dcat:hadRole tcs:wrappedConfigShape ;
        dct:relation [
            a sh:NodeShape;
            # ...
            # the variables from here https://github.com/lblod/loket-error-alert-service#environment-variables
            # variable for string of template
            # with additional constraints that we can express
        ]
    ] ; 
    tcs:unwrapConfig "CONSTRUCT ...." # the delta rule is just a constant https://github.com/lblod/loket-error-alert-service#in-a-musemtech-stack, 
    # turning the template string into a file... (we can insert request triples to write a file as a hint for the pipeline generator to actually write the file with its contents)
    # the other variables from above translated trivially to docker variables
    .

sw:deliver-email-service a tcs:PipelineComponent, mu:Microservice, dcat:Resource ;
  rdfs:description "Microservice that delivers emails from a mail folder" ;
  dcat:landingPage <https://github.com/lblod/berichtencentrum-deliver-email-service> ;
  dct:requires sw:triple-store ,
               sw:mu-identifier ;
  dcat:qualifiedRelation 
        [
            dcat:hadRole tcs:inputShape ;
            dct:relation loket:MailShape # to verify!
        ] ,
        [
        a dcat:Relationship;
        dcat:hadRole tcs:configShape ;
        dct:relation sw:genericSWConfigShape 
        ],
        [
        a dcat:Relationship;
        dcat:hadRole tcs:wrappedConfigShape ;
        dct:relation [
            a sh:NodeShape;
            # ...
            # the variables from here https://github.com/lblod/berichtencentrum-deliver-email-service#environment-variables
            # with additional constraints that we can express
        ]
    ] ; 
    tcs:unwrapConfig "CONSTRUCT ...." ; # no delta rules; no additional files
    # the variables from above translated trivially to docker variables
  tcs:config :DeliverEmailServiceDockerCompose .

# shapes can be more specific and depend on input but yeah...
# shapes defined by llm; to verify!

loket:ErrorShape a sh:NodeShape ;
    sh:targetClass oslc:Error ;

    sh:property [
        sh:path mu:uuid ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path dct:subject ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path oslc:message ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path dct:created ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path dct:creator ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path dct:references ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path oslc:largePreview ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] .

loket:EmailShape a sh:NodeShape ;
    sh:targetClass nmo:Email ;

    sh:property [
        sh:path mu:uuid ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path nmo:isPartOf ;
        sh:nodeKind sh:IRI ;
        sh:hasValue <http://data.lblod.info/id/mail-folders/2> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path nmo:messageSubject ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path nmo:htmlMessageContent ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path nmo:emailTo ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path nmo:messageFrom ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path dct:creator ;
        sh:nodeKind sh:IRI ;
        sh:hasValue <http://lblod.data.gift/services/loket-error-alert-service> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path dct:references ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node loket:ErrorReadShape ;
    ] .